#usda 1.0
(
    defaultPrim = "quad"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "quad" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    custom bool newton:selfCollisionEnabled = 1
    custom bool physxArticulation:enabledSelfCollisions = 1

    def Xform "Quad_v01" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (4.5, 6.5, 10.1)
        float physics:mass = 60
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "Quad_v01_geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </quad/Looks/physicsMaterial_0> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom int mjc:condim = 3
            custom int mjc:priority = 0
            custom float[] mjc:solimp = [0.9, 0.95, 0.001, 0.5, 2]
            custom float mjc:solmix = 1
            custom float newton:contact_kd = 200
            custom float newton:contact_ke = 10000
            custom float newton:contactMargin = 0
            color3f[] primvars:displayColor = [(0.3, 0.8, 0.35)]
            double size = 2
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.55, 0.45, 0.15)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def "Looks"
    {
        def Material "physicsMaterial_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            custom float newton:rollingFriction = 0.0001
            custom float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

