    def Scope "joints"
    {
        def PhysicsRevoluteJoint "j0_pitch" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0
            float drive:angular:physics:maxForce = 6
            float drive:angular:physics:stiffness = 0.5235988
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            custom float mjc:damping = 2
            custom float newton:angular:limitDamping = 0
            custom float newton:angular:limitStiffness = 0
            custom float newton:armature = 0.01
            custom float newton:friction = 0
            uniform token physics:axis = "Y"
            rel physics:body0 = </worm/seg0>
            rel physics:body1 = </worm/link0>
            point3f physics:localPos0 = (-0.1, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -44.999992
            float physics:upperLimit = 44.999992
            custom float physxJoint:armature = 0.01
        }

        def PhysicsRevoluteJoint "j0_yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
