#usda 1.0
(
    defaultPrim = "worm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "worm" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
)
{
    custom bool newton:selfCollisionEnabled = 1
    custom bool physxArticulation:enabledSelfCollisions = 1

    def "Looks"
    {
        def Material "wormPhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            custom float newton:rollingFriction = 0.0001
            custom float newton:torsionalFriction = 0.005
            float physics:dynamicFriction = 0.9
            float physics:restitution = 0
            float physics:staticFriction = 0.9
        }
    }

    def Xform "seg0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.005694777, 0.005694777, 0.0012753666)
        float physics:mass = 1.335962
        quatf physics:principalAxes = (0.70710677, 0, -0.70710677, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Capsule "collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysicsFilteredPairsAPI"]
        )
        {
            uniform token axis = "X"
            double height = 0.15
            rel material:binding:physics = </worm/Looks/wormPhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )
            custom float newton:contact_kd = 200
            custom float newton:contact_ke = 10000
            custom float newton:contactMargin = 0
            prepend rel physics:filteredPairs = </worm/seg1/collision>
            color3f[] primvars:displayColor = [(0.35, 0.55, 0.9)]
            double radius = 0.045
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "link0" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.0002, 0.0002, 0.0002)
        float physics:mass = 0.1
        quatf physics:principalAxes = (1, 0, 0, 0)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (-0.1, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Xform "seg1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
