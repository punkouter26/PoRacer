    def Scope "Looks"
    {
        def Material "material_rgba"
        {
            token outputs:mdl:displacement.connect = </worm/Looks/material_rgba/Shader.outputs:out>
            token outputs:mdl:surface.connect = </worm/Looks/material_rgba/Shader.outputs:out>
            token outputs:mdl:volume.connect = </worm/Looks/material_rgba/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.35, 0.55, 0.9)
                token outputs:out
            }
        }

        def Material "material_rgba_0"
        {
            token outputs:mdl:displacement.connect = </worm/Looks/material_rgba_0/Shader.outputs:out>
            token outputs:mdl:surface.connect = </worm/Looks/material_rgba_0/Shader.outputs:out>
            token outputs:mdl:volume.connect = </worm/Looks/material_rgba_0/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.3, 0.32, 0.35)
                token outputs:out
            }
        }
    }

