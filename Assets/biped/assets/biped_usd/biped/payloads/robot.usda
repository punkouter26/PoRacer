#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "biped"
    doc = """Generated from Composed Stage of root layer C:\\Users\\punko\\AppData\\Local\\Temp\\tmpqv2j1uxi\\biped.usdc


Generated from Composed Stage of root layer C:\\Users\\punko\\AppData\\Local\\Temp\\urdf_import_biped_5cgrx4ad\\usdex_biped\\biped.usdc


Generated from Composed Stage of root layer C:\\Users\\punko\\AppData\\Local\\Temp\\urdf_import_biped_5cgrx4ad\\temp_biped\\biped.usd


