"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "biped" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "L_hip_yaw" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_hip_yaw" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_hip_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_knee" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "L_ankle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_hip_roll" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_hip_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_knee" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "R_ankle" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "torso" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "L_hip_yaw_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "L_hip_roll_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "L_thigh" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "L_shank" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "L_foot" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }

            over "R_hip_yaw_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "R_hip_roll_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "R_thigh" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "R_shank" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "R_foot" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                            }
                        }
                    }
                }
            }
        }
    }
}

