---
config:
  theme: base
  themeVariables:
    fontSize: "17px"
    fontFamily: "ui-sans-serif, Segoe UI, system-ui, sans-serif"
    primaryColor: "#e8eefc"
    primaryTextColor: "#10203a"
    primaryBorderColor: "#3f6ee0"
    lineColor: "#5b6b86"
---
flowchart LR
    OBS["<b>1. Observe</b><br/>CollectObservations<br/>joint angles, contacts,<br/>goal vector, terrain probes"]
    NET["<b>2. Decide</b><br/>ONNX policy<br/>Inference Engine, CPU"]
    ACT["<b>3. Act</b><br/>OnActionReceived<br/>action -1..1 &rarr; xDrive.target"]
    PHY["<b>4. Simulate</b><br/>PhysX ArticulationBody<br/>&Delta;t = 0.005 s (200 Hz)"]
    TERM{"<b>5. Terminal?</b><br/>goal reached &middot; fell &middot;<br/>stalled &middot; out of bounds"}
    RESET["<b>6. Reset</b><br/>OnEpisodeBegin<br/>clear fatigue, restore drives"]

    OBS --> NET --> ACT --> PHY --> TERM
    TERM -- "no (hold action<br/>for 20 ticks)" --> PHY
    TERM -- "no (new decision)" --> OBS
    TERM -- "yes" --> RESET --> OBS

    classDef sense fill:#e3f0ff,stroke:#2f6fd0,stroke-width:2px,color:#0b2545;
    classDef brain fill:#efe6ff,stroke:#7c4dd0,stroke-width:2px,color:#2a1055;
    classDef phys fill:#fff2dc,stroke:#c98a12,stroke-width:2px,color:#4a3200;
    classDef ctrl fill:#e6f7ec,stroke:#2e9e5b,stroke-width:2px,color:#0d3d22;
    class OBS sense;
    class NET brain;
    class ACT,PHY phys;
    class TERM,RESET ctrl;
