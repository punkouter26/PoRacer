*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Python / ML-Agents
# Timer reports are rewritten on every play session — generated, not source.
Assets/ML-Agents/Timers/
.venv/
Packages/manifest.json.bak
__pycache__/
results/
*.onnx.meta.bak

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Written into Assets/ by the performance-testing package on every run.
Assets/Resources/PerformanceTestRun*.json
Assets/Resources/PerformanceTestRun*.json.meta

# Scratch capture folder used by editor tooling.
Assets/Temp/
Assets/Temp.meta
test-results.xml

# Play publishing tooling venv. Kept out of .venv on purpose: that one carries
# load-bearing ml-agents/torch pins a stray resolve would walk over.
scripts/publish-venv/

# Local Python 3.11 for the Isaac Lab side. Installed into the repo folder on
# purpose (this machine has no system 3.11, and .venv's 3.10 carries the
# load-bearing ml-agents/torch pins). Binaries — never committed.
Python311/

# Isaac Lab checkout + Isaac Sim wheels, cloned by ISAAC/install.ps1. Tens of GB
# of third-party source and binaries; the repo only owns what ISAAC/ authors.
ISAAC/isaaclab/
ISAAC/isaaclab3/
ISAAC/logs/

# Python build artifacts from the editable ISAAC task package.
*.egg-info/

# MuJoCo Warp training venv for the Boy_Character rig (Windows, Python 3.11.9).
# Kept out of .venv on purpose: that one carries the ml-agents/torch pins.
.venv-mjwarp/
# Its replacement (2026-09-25): same role, rebuilt with uv - torch cu128 for the
# RTX 50-series GPU, mujoco-warp, tensorboard, onnx. The old folder is held open by
# leaked TensorBoard processes.
.venv-mujoco/

# Training run binaries. The gate evidence JSON in runs/ is small and worth
# keeping; the checkpoints and TFEvents are large, reproducible, and were being
# written mid-run when they first got staged.
training/*/runs/**/*.pt
training/*/runs/**/events.out.tfevents.*

# Written into the project root by the MuJoCo plug-in whenever its tests or a
# MjScene run. Generated, never source.
MUJOCO_LOG.TXT

# ML-Agents timer dumps and editor captures; regenerated on every play
Assets/ML-Agents/
Assets/Temp/
Assets/InitTestScene*
Assets/ML-Agents.meta
Assets/Art/Models/Source~/

# Unity's crash-recovery copies. The Editor writes these into Assets/ after a
# hard crash (2026-09-09: mujoco.dll took the process down), where they are then
# imported on every domain reload - a 6 MB scene re-parsed for nothing. They hold
# no unsaved work the .unity file lacks; delete them once the scene is verified.
Assets/_Recovery/
Assets/_Recovery.meta

# MuJoCo import staging. Assets/Local/ is where MojucuBoySetup and
# Editor_RegisterMojucuBoyRacer unpack a drop before its useful parts are moved
# into the project proper; 71182d0 removed the checked-in copy on purpose. Unity
# regenerates Assets/Local.meta whenever the (empty) folder exists on disk, and
# git cannot track an empty folder, so the meta shows up untracked forever with
# nothing to attach to - an orphaned .meta, which the project rules forbid.
Assets/Local/
Assets/Local.meta

# Transient per-session harness state. Its siblings in .claude/state/ are
# tracked on purpose; this one is rewritten on every context compaction.
.claude/state/precompact-state.md

# Written by the IvanMurzak Unity-MCP plugin; carries a cloud auth token.
.mcp.json

# Worm5 MuJoCo training runs (checkpoints, TensorBoard events); the exported ONNX is in training/worm/export.
training/worm/mujoco/runs/
