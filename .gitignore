# Unity generated
[Ll]ibrary/
[Tt]emp/
# Android NDK/CMake scratch from a gradle player build.
.utmp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset store / plugins caches
[Aa]ssets/AssetStoreTools*
[Aa]ssets/Plugins/Editor/JetBrains*

# IDE & Local Config
.vs/
.vscode/
.claude/settings.local.json
*.sln
*.slnx
# Regenerated by the IDE package on every load; two of these (Assembly-CSharp*)
# predate the asmdefs and no longer correspond to any assembly.
*.csproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# OS
.DS_Store
Thumbs.db

# Unity crash reports
sysinfo.txt
crashlytics-build.properties

# Python / ML-Agents
# Timer reports are rewritten on every play session — generated, not source.
Assets/ML-Agents/Timers/
.venv/
Packages/manifest.json.bak
__pycache__/
results/
*.onnx.meta.bak

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Written into Assets/ by the performance-testing package on every run.
Assets/Resources/PerformanceTestRun*.json
Assets/Resources/PerformanceTestRun*.json.meta

# Scratch capture folder used by editor tooling.
Assets/Temp/
Assets/Temp.meta
test-results.xml

# Play publishing tooling venv. Kept out of .venv on purpose: that one carries
# load-bearing ml-agents/torch pins a stray resolve would walk over.
Tools/publish-venv/

# Local Python 3.11 for the Isaac Lab side. Installed into the repo folder on
# purpose (this machine has no system 3.11, and .venv's 3.10 carries the
# load-bearing ml-agents/torch pins). Binaries — never committed.
Python311/

# Isaac Lab checkout + Isaac Sim wheels, cloned by ISAAC/install.ps1. Tens of GB
# of third-party source and binaries; the repo only owns what ISAAC/ authors.
ISAAC/isaaclab/
ISAAC/logs/

# Python build artifacts from the editable ISAAC task package.
*.egg-info/

# MuJoCo Warp training venv for the Boy_Character rig (Windows, Python 3.11.9).
# Kept out of .venv on purpose: that one carries the ml-agents/torch pins.
.venv-mjwarp/

# Training run binaries. The gate evidence JSON in runs/ is small and worth
# keeping; the checkpoints and TFEvents are large, reproducible, and were being
# written mid-run when they first got staged.
training/*/runs/**/*.pt
training/*/runs/**/events.out.tfevents.*

# Written into the project root by the MuJoCo plug-in whenever its tests or a
# MjScene run. Generated, never source.
MUJOCO_LOG.TXT

# ML-Agents timer dumps and editor captures; regenerated on every play
Assets/ML-Agents/
Assets/Temp/
Assets/InitTestScene*
